
const BASE = "https://api-web.nhle.com/v1";
const STATS = "https://api.nhle.com/stats/rest/en";

module.exports = async (req, res) => {
  const { type, date } = req.query;

  const routes = {
    score: `${BASE}/score/${validDate(date)}`,
    standings: `${BASE}/standings/now`,
    schedule: `${BASE}/scoreboard/now`,
    points: `${BASE}/skater-stats-leaders/current?categories=points&limit=10`,
    goals: `${BASE}/skater-stats-leaders/current?categories=goals&limit=10`,
    finns: `${STATS}/skater/summary?isAggregate=false&isGame=false&limit=100&sort=points&cayenneExp=${encodeURIComponent("gameTypeId=2 and nationalityCode='FIN'")}`
  };

  if (!routes[type]) {
    return res.status(400).json({ error: "Unknown data type" });
  }

  try {
    const response = await fetch(routes[type], {
      headers: { Accept: "application/json" }
    });

    if (!response.ok) {
      throw new Error(`NHL API returned ${response.status}`);
    }

    const data = await response.json();

    res.setHeader("Cache-Control", "s-maxage=30, stale-while-revalidate=60");
    return res.status(200).json(data);
  } catch (error) {
    console.error("NHL API error:", error);
    return res.status(502).json({
      error: "NHL data temporarily unavailable"
    });
  }
};

function validDate(value) {
  if (typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
    return value;
  }
  return "now";
}

